#!/usr/bin/env bash
# Build the web assets and server, then serve a collection on this network.
#   tools/run-web [--release] [path/to/collection.anki2] [extra evolanki-server args]
# With no path, a demo collection in out/web-dev is created on first use.
# --release builds with optimisations, which is what to use for real.
set -e

profile=()
if [ "$1" = "--release" ]; then
    profile=(--release)
    shift
fi

# resolved here, as the rest runs from the top of the repo
collection=
if [ $# -ge 1 ] && [ "${1#-}" = "$1" ]; then
    collection=$(realpath -m -- "$1")
    shift
fi

cd "$(dirname "$0")/.."
just build

serve=(cargo run "${profile[@]}" -p evolanki-server --bin evolanki-server -- --web-root "$PWD/out/web")
if [ -n "$collection" ]; then
    exec "${serve[@]}" --collection "$collection" "$@"
fi
exec "${serve[@]}" --collection "$PWD/out/web-dev/demo.anki2" --create --seed-demo "$@"
