#!/usr/bin/env bash
# Build the release server, admin tool and web pages, and install them under
# ~/.local/share/evolanki, to run from a stable path. Only touches bin/ and web/
# there, never a collection. Set EVOLANKI_HOME to install elsewhere.
set -euo pipefail

home=${EVOLANKI_HOME:-$HOME/.local/share/evolanki}

cd "$(dirname "$0")/.."
just build
# in case CARGO_TARGET_DIR is set elsewhere, as the paths below expect out/rust
export CARGO_TARGET_DIR="$PWD/out/rust"
cargo build --release --locked -p evolanki-server

mkdir -p "$home/bin"
chmod 700 "$home"
for binary in evolanki-server evolanki-admin; do
    # by renaming, as a server may be running from the old one
    install -m 755 "out/rust/release/$binary" "$home/bin/.$binary.new"
    mv -f "$home/bin/.$binary.new" "$home/bin/$binary"
done
rm -rf "$home/.web.new" "$home/.web.old"
cp -aL out/web "$home/.web.new"
if [ -e "$home/web" ]; then
    mv "$home/web" "$home/.web.old"
fi
mv "$home/.web.new" "$home/web"
rm -rf "$home/.web.old"

cat <<DONE

Installed to $home. Restart a running server to pick this up. To serve on the LAN:

  $home/bin/evolanki-server --collection $home/collection.anki2 --web-root $home/web

Admin tool: $home/bin/evolanki-admin (see docs/admin-cli.md)
DONE
